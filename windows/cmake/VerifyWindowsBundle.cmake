cmake_minimum_required(VERSION 3.22)
foreach(required STAGE LOG_DIR APP_VERSION)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
foreach(file tux-sstv.exe tux-sstv-audio.exe rigctl.exe qt.conf platforms/qwindows.dll platforms/qoffscreen.dll)
  if(NOT EXISTS "${STAGE}/${file}")
    message(FATAL_ERROR "Missing bundle component: ${file}")
  endif()
endforeach()
file(GLOB media "${STAGE}/multimedia/*.dll")
if(NOT media)
  message(FATAL_ERROR "Missing Qt camera backend plugin")
endif()
file(READ "${LOG_DIR}/staged-version.txt" version)
string(STRIP "${version}" version)
if(NOT version STREQUAL "Tux-sstv ${APP_VERSION}")
  message(FATAL_ERROR "Incorrect staged version: ${version}")
endif()
file(READ "${LOG_DIR}/staged-modes.json" modes)
string(JSON count LENGTH "${modes}")
if(NOT count EQUAL 43)
  message(FATAL_ERROR "Expected 43 SSTV modes, got ${count}")
endif()
file(READ "${LOG_DIR}/staged-radio-models.txt" models)
string(REGEX MATCHALL "\n[ ]*[0-9]+[ ]+" rows "${models}")
list(LENGTH rows count)
if(count LESS 100)
  message(FATAL_ERROR "Hamlib model catalog is incomplete: ${count} models")
endif()
message(STATUS "Staged Windows components, version, SSTV modes and Hamlib catalog verified")
